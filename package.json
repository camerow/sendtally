{
  "name": "sendtally",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "preview:build": "CLOUDFLARE_ENV=production pnpm --filter @sendtally/web build",
    "preview:upload": "pnpm run preview:build && pnpm --filter @sendtally/web exec wrangler versions upload",
    "lint": "eslint .",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "format": "turbo format --continue -- && prettier --write \"*.{md,json,yaml,yml}\" \"docs/**/*.md\"",
    "format:check": "turbo format:check --continue -- && prettier --check \"*.{md,json,yaml,yml}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ]
    }
  }
}
