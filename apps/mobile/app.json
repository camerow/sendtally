{
  "expo": {
    "name": "sendtally",
    "slug": "sendtally",
    "version": "0.17.0",
    "scheme": "sendtally",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "primaryColor": "#f9dc5c",
    "ios": {
      "bundleIdentifier": "com.sendtally.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "de", "fr", "es"]
      },
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:sendtally.com"]
    },
    "android": {
      "package": "com.sendtally.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9dc5c"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "sendtally.com",
              "path": "/app"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/sessions"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/journal"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/projects"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/trends"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/settings"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/account"
            },
            {
              "scheme": "https",
              "host": "sendtally.com",
              "pathPrefix": "/app/membership"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f9dc5c"
        }
      ],
      "expo-localization",
      "posthog-react-native/expo",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-play-compliance.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4dea1644-ecbb-43e8-ad9c-a6f646f6d844"
      }
    },
    "owner": "chalk-and-circuits",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4dea1644-ecbb-43e8-ad9c-a6f646f6d844"
    }
  }
}
