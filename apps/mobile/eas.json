{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "24.19.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sendtally.com",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc2VuZHRhbGx5LmNvbSQ",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_TsTamyxqBbukzZbEAUieLNrZABL",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_IlzSBshbPLcWxzBbHZkHCdJoeOn"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "test_RuludwkwBfxgCwPaffqspLVvcOp",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "test_RuludwkwBfxgCwPaffqspLVvcOp"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6810779919",
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyId": "$ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_API_KEY_ISSUER_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
