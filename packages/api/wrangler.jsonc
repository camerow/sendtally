{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendtally-api",
  "account_id": "f3514650e9f74f7fe7db71fdd6577a8f",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "observability": { "enabled": true },
  // Pinned so a busy port fails loudly. Without it wrangler picks the next free
  // one, the web app keeps calling the API_URL it was given, and every screen
  // sits loading with nothing to say.
  "dev": { "port": 8787 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendtally-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "WEB_APP_URL": "http://localhost:5173",
  },
  "env": {
    "staging": {
      "routes": [{ "pattern": "api-staging.sendtally.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sendtally-staging",
          "database_id": "3b3763e2-2c97-4729-9dee-b8b4242785c8",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "WEB_APP_URL": "https://staging.sendtally.com",
        "PREVIEW_ORIGIN_SUFFIX": "-sendtally-web-staging.chalk-and-circuits.workers.dev",
        // No PostHog token: staging is the pull request sandbox and the e2e flows, so its
        // server-side captures would land in the one project alongside real ones. An absent
        // token is a no-op in getPostHog, so nothing else changes. apps/web declares its own
        // token on production only for the same reason - staging missing one is the design,
        // not an oversight to correct.
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
    },
    "production": {
      "routes": [{ "pattern": "api.sendtally.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sendtally-production",
          "database_id": "974644dc-05b4-4e20-bd0e-f7d1b7c609ea",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "WEB_APP_URL": "https://sendtally.com",
        "POSTHOG_PROJECT_TOKEN": "phc_mK5KViTzigeXd5KwHRkP2pK2WNCSUdeTcvmTEudpatRH",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
    },
  },
}
