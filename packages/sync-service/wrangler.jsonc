{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendtally-sync-service",
  "account_id": "f3514650e9f74f7fe7db71fdd6577a8f",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendtally-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "WEB_APP_URL": "http://localhost:5173",
  },
  "env": {
    "staging": {
      "routes": [{ "pattern": "api-staging.sendtally.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sendtally-staging",
          "database_id": "3b3763e2-2c97-4729-9dee-b8b4242785c8",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "WEB_APP_URL": "https://staging.sendtally.com",
        "PREVIEW_ORIGIN_SUFFIX": "-sendtally-web-staging.chalk-and-circuits.workers.dev",
        "POSTHOG_PROJECT_TOKEN": "phc_mK5KViTzigeXd5KwHRkP2pK2WNCSUdeTcvmTEudpatRH",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
    },
    "production": {
      "routes": [{ "pattern": "api.sendtally.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sendtally-production",
          "database_id": "974644dc-05b4-4e20-bd0e-f7d1b7c609ea",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "WEB_APP_URL": "https://sendtally.com",
        "POSTHOG_PROJECT_TOKEN": "phc_mK5KViTzigeXd5KwHRkP2pK2WNCSUdeTcvmTEudpatRH",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
    },
  },
}
